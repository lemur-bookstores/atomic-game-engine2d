{
  "name": "atomic-game-engine2d",
  "version": "0.8.0",
  "description": "A lightweight 2D game engine for web browsers with ECS architecture",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "types": "dist/types/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:types && vite build",
    "build:types": "tsc --project tsconfig.build.json",
    "build:clean": "rm -rf dist && npm run build",
    "build:debug": "DEBUG=vite-plugin-dts* npm run build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "game-engine",
    "2d",
    "webgl",
    "canvas",
    "ecs",
    "physics",
    "typescript"
  ],
  "author": "GameEngine Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemur-bookstores/atomic-game-engine2d.git"
  },
  "devDependencies": {
    "@types/uuid": "10.0.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.3.0",
    "@typescript-eslint/eslint-plugin": "8.40.0",
    "@typescript-eslint/parser": "8.40.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.33.0",
    "jsdom": "26.1.0",
    "terser": "5.43.1",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vite-plugin-dts": "4.5.4",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "box2d-wasm": "7.0.0",
    "gl-matrix": "3.4.4",
    "uuid": "11.1.0"
  },
  "size-limit": [
    {
      "path": "dist/index.esm.js",
      "limit": "100 kB",
      "webpack": false
    },
    {
      "path": "dist/index.cjs.js",
      "limit": "100 kB"
    }
  ]
}
